# Leave empty in development: requests then stay same-origin and the Vite dev
# proxy routes them per service prefix (see vite.config.ts). Set absolute URLs
# for production builds, e.g. https://api.mtgmods.com
VITE_USER_API_URL=
VITE_LICENSE_API_URL=
VITE_USAGE_API_URL=
VITE_DISTRIBUTION_API_URL=

# Where the dev proxy forwards to when no per-service target is set below.
# The public gateway serves every service under /v1/<service>.
VITE_DEV_GATEWAY_TARGET=https://api.mtgmods.com

# Point a single service at a local instance without touching the others.
# Requests are rewritten to /api/v1/... because only the gateway strips /api.
# VITE_DEV_USER_TARGET=http://127.0.0.1:8001
# VITE_DEV_LICENSE_TARGET=http://127.0.0.1:8002
# VITE_DEV_USAGE_TARGET=http://127.0.0.1:8003
# VITE_DEV_DISTRIBUTION_TARGET=http://127.0.0.1:8005
