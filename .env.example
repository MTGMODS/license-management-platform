# ---------------------------------------------------------------------------
# API base URLs
# ---------------------------------------------------------------------------
# Leave empty in development: requests then stay same-origin and the Vite dev
# proxy routes them per service prefix (see vite.config.ts). Set absolute URLs
# for production builds.
VITE_USER_API_URL=
VITE_LICENSE_API_URL=
VITE_USAGE_API_URL=
VITE_DISTRIBUTION_API_URL=

# ---------------------------------------------------------------------------
# Dev proxy targets
# ---------------------------------------------------------------------------
# User and Distribution ports are taken from the backend .env.example files.
# License and Usage ports are NOT defined anywhere in the backend repo — the
# values below are placeholders and must be confirmed.
VITE_DEV_USER_TARGET=http://127.0.0.1:8001
VITE_DEV_LICENSE_TARGET=http://127.0.0.1:8002
VITE_DEV_USAGE_TARGET=http://127.0.0.1:8003
VITE_DEV_DISTRIBUTION_TARGET=http://127.0.0.1:8005
