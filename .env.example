# Public gateway. Production / Docker bake this into the JS bundle.
# `vite` dev ignores it in the browser (same-origin + proxy) and uses it only
# as the fallback target when a VITE_DEV_*_TARGET below is unset.
VITE_API_URL=https://api.mtgmods.com

# Canonical / Open Graph origin. Defaults to https://mtgmods.com when unset.
# VITE_SITE_URL=https://mtgmods.com

# Point a service at a local instance. Comment a line out to send that prefix
# to VITE_API_URL instead (mixed local + already-deployed API).
# Requests to a local target are rewritten to /api/v1/... because only the
# gateway strips /api. OAuth still opens VITE_DEV_USER_TARGET directly so the
# oauth_state cookie matches the Discord/Telegram callback host.
# VITE_DEV_USER_TARGET=http://127.0.0.1:8001
# VITE_DEV_LICENSE_TARGET=http://127.0.0.1:8002
# VITE_DEV_USAGE_TARGET=http://127.0.0.1:8003
# VITE_DEV_DISTRIBUTION_TARGET=http://127.0.0.1:8005
