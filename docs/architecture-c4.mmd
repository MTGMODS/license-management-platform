flowchart LR
  %% C4-style container view of the current production deployment.
  %% The Helper is an existing external product. Host nginx runs outside Compose.

  Player["Person: Player<br/>Browser is the main interface"]
  MiniApp["Client: Telegram Mini App<br/>Same web application inside Telegram"]
  Helper["External client: Arizona/Rodina Helper<br/>Free and VIP"]
  Telegram["External system: Telegram Bot API"]
  Discord["External system: Discord API"]
  OAuth["External systems: Telegram / Discord OAuth"]
  Nginx["Infrastructure: Nginx HTTPS gateway<br/>production host, outside Compose"]

  Player -->|HTTPS| Nginx
  Player -->|Opens from Telegram| MiniApp
  MiniApp -->|HTTPS: website and API| Nginx
  Helper -->|HTTPS: license check + usage launch| Nginx

  subgraph MTG["Software system: MTG MODS platform"]
    direction LR

    Web["Container: Web nginx<br/>React SPA + static free installer"]
    Installer[("Read-only installer directory<br/>Public base EXE only")]

    subgraph Backend["Backend containers · Docker Compose network"]
      direction TB

      UserAPI["Container: User Service<br/>FastAPI · OAuth/JWT/profile"]
      LicenseAPI["Container: License Service<br/>FastAPI · activation/check/sales"]
      UsageAPI["Container: Usage Service<br/>FastAPI · launch telemetry/stats"]
      DistributionAPI["Container: Distribution Service<br/>FastAPI · VIP Lua / stamped EXE"]

      UserDB[("Container: PostgreSQL<br/>Users, refresh sessions, OAuth handoffs")]
      LicenseDB[("Container: PostgreSQL<br/>License DB · licenses/devices/transactions")]
      UsageDB[("Container: PostgreSQL<br/>Usage DB · launches")]
      Rabbit["Container: RabbitMQ<br/>file-generation RPC + bot commands"]
      Redis[("Container: Redis<br/>shared public stats cache + refresh locks")]
      Assets["Private files<br/>VIP template + obfuscator"]
      BuildFiles[("Mounted builds directory<br/>Temporary Lua / EXE / used markers")]
      TgBot["Container: Telegram bot<br/>Stars payments + VIP chat"]
      DsBot["Container: Discord bot<br/>VIP roles + messages"]
    end

    UserAPI --> UserDB
    LicenseAPI --> LicenseDB
    UsageAPI --> UsageDB
    LicenseAPI -->|Redis protocol · sales stats| Redis
    UsageAPI -->|Redis protocol · usage stats| Redis
    LicenseAPI -->|HTTP · profile/social ID lookup| UserAPI
    LicenseAPI -->|RabbitMQ · file request and RPC wait| Rabbit
    Rabbit -->|file_generation_queue| DistributionAPI
    DistributionAPI -->|RPC response with download URL| Rabbit
    DistributionAPI --> Assets
    DistributionAPI --> BuildFiles
    DistributionAPI -->|Reads base EXE for stamping| Installer
    Web -->|Serves free EXE directly| Installer
    LicenseAPI -->|RabbitMQ · VIP expiry commands| Rabbit
    Rabbit -->|discord.#| DsBot
    Rabbit -->|telegram.#| TgBot
    TgBot -->|HTTP · bot endpoints| LicenseAPI
    DsBot -->|HTTP · bot endpoints| LicenseAPI
    TgBot -->|Opens website / Mini App| MiniApp
  end

  Nginx -->|HTTP :8080| Web
  Nginx -->|HTTP :8001| UserAPI
  Nginx -->|HTTP :8002| LicenseAPI
  Nginx -->|HTTP :8003| UsageAPI
  Nginx -->|HTTP :8005| DistributionAPI

  UserAPI -->|HTTPS · OAuth login| OAuth
  TgBot -->|HTTPS| Telegram
  DsBot -->|HTTPS| Discord

  classDef person fill:#ffffff,stroke:#374151,color:#111827
  classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827
  classDef app fill:#e8f1ff,stroke:#2563eb,color:#111827
  classDef data fill:#ecfdf5,stroke:#059669,color:#111827
  class Player person
  class Helper,MiniApp,Telegram,Discord,OAuth,Nginx external
  class Web,UserAPI,LicenseAPI,UsageAPI,DistributionAPI,Rabbit,TgBot,DsBot app
  class UserDB,LicenseDB,UsageDB,Redis,Assets,BuildFiles,Installer data
