# --- Local dev (SQLite) ---
# DATABASE_URL=sqlite+aiosqlite:///./users.db
# DEBUG_MODE=True

# --- Docker Compose (Postgres) ---
DATABASE_URL=postgresql+asyncpg://mtg_user:change_me_user_db@user-postgres:5432/users
DATABASE_POSTGRES_URL=postgresql+asyncpg://mtg_user:change_me_user_db@user-postgres:5432/users
DEBUG_MODE=False

POSTGRES_USER=mtg_user
POSTGRES_PASSWORD=change_me_user_db
POSTGRES_DB=users

JWT_SECRET=change_me_jwt_secret
INTERNAL_SECRET_TOKEN=change_me_internal_token

FRONTEND_URL=http://localhost:5173

DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=http://localhost:8001/api/v1/users/auth/discord/callback

TELEGRAM_CLIENT_ID=replace_me
TELEGRAM_CLIENT_SECRET=replace_me
TELEGRAM_CALLBACK_URL=http://localhost:8001/api/v1/users/auth/telegram/callback
TELEGRAM_BOT_TOKEN=replace_me

APP_VERSION=1.0
API_VERSION=v1
